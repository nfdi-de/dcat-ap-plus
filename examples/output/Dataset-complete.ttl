    dcterms:conformsTo [ a dcterms:Standard ;
            dcterms:description "Guiding principles for modern data management." ;
            dcterms:title "FAIR Data Principles",
                "FAIR-Datenprinzipien" ],
        [ a dcterms:Standard ;
            dcterms:description "DCAT-AP+ is a LinkML-based extension of the DCAT Application Profile 3.0 that adds a provenance layer for describing how a dataset was generated and what it is about, using the Starting Point Terms of PROV-O, the QUDT ontology, and Dublin Core Terms. ",
                "DCAT-AP+ ist eine auf LinkML basierende Erweiterung des DCAT-Anwendungsprofils 3.0, die eine Provenienzebene hinzufügt, um zu beschreiben, wie ein Datensatz generiert wurde und worum es darin geht. Dabei kommen die „Starting Point Terms“ von PROV-O, die QUDT-Ontologie und die Dublin-Core-Begriffe zum Einsatz." ;
            dcterms:identifier <https://w3id.org/nfdi-de/dcat-ap-plus> ;
            dcterms:title "DCAT-AP Plus Links to Use-case Specific Context (DCAT-AP+)",
                "DCAT-AP+" ;
            adms:identifier [ a adms:Identifier ;
                    dcterms:description "This identifier links to the GitHub pages documentation of the DCAT-AP+." ;
                    dcterms:title "GitHub pages URL" ;
                    skos:notation "https://nfdi-de.github.io/dcat-ap-plus/" ],
                [ a adms:Identifier ;
                    dcterms:description "This identifier is the official PURL of the DCAT-AP+." ;
                    dcterms:title "official PURL" ;
                    skos:notation "https://w3id.org/nfdi-de/dcat-ap-plus" ] ] ;
    dcterms:creator [ a foaf:Agent,
                foaf:Organization ;
            dcterms:identifier <https://ror.org/42marvel1234> ;
            dcterms:type [ a skos:Concept ;
                    dcterms:identifier <http://purl.org/adms/publishertype/Company> ;

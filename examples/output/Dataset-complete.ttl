            dcat:bbox "POLYGON((5.8663 47.2701, 15.0419 47.2701, 15.0419 55.0581, 5.8663 55.0581, 5.8663 47.2701))" ;
            dcat:centroid "POINT(10.4515 51.1657)" ;
